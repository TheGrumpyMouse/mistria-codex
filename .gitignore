node_modules/
dist/
*.tsbuildinfo

# Build output and intermediates — regenerate with `pnpm build:data` / `pnpm build:ship`
# Anchored: an unanchored `build/` also matched packages/pipeline/src/build/,
# which silently kept the entire build pipeline out of every commit.
/build/
apps/web/public/data/
# Packed atlases. The committed copies live in assets/game/ — see docs/DATA-POLICY.md.
apps/web/public/assets/
# The static crawler guide and its index files, from `pnpm build:seo`. Rewritten
# wholesale every run, so nothing hand-written may live in guide/.
apps/web/public/guide/
apps/web/public/sitemap.xml
apps/web/public/robots.txt
apps/web/public/llms.txt

# HTTP cache for the wiki fetcher
.cache/

# Never commit a game install path
.env
.env.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright MCP scratch output
.playwright-mcp/

# Pasted wiki page source, at the repo root, while working out a parser.
# Three of these (cos/acc/body.txt — the cosmetics pages) were committed by
# accident and carried verbatim wiki prose. Page wikitext is never committed;
# the parsed, facts-only result belongs in sources/wiki/pages/.
/*.txt

# Internal docs
docs/assets
docs/research