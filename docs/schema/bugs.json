{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/bugs.json",
  "title": "bugs",
  "description": "Bug-only fields, keyed to an item. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "spawn_surface": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "grass",
              "rock",
              "tree",
              "ground",
              "water",
              "air"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "spawn_condition_key": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "rarity": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "item_id",
      "spawn_surface",
      "spawn_condition_key",
      "rarity"
    ],
    "additionalProperties": false
  }
}
