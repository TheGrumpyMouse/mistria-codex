{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/characters.json",
  "title": "characters",
  "description": "Villagers, vendors and romance candidates. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "numeric_id": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "numeric_id_game_version": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "id_status": {
        "default": "provisional",
        "type": "string",
        "enum": [
          "provisional",
          "confirmed_stale",
          "confirmed"
        ]
      },
      "former_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "game_version": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "version_added": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "type": "string",
        "enum": [
          "verified",
          "wiki",
          "inferred"
        ]
      },
      "prov": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "enum": [
            "game_files",
            "wiki_cargo",
            "wiki_page",
            "manual",
            "community_archive"
          ]
        }
      },
      "data_gaps": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "icon_key": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "wiki_page": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "blurb": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "maxLength": 300
          },
          {
            "type": "null"
          }
        ]
      },
      "birthday": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "season": {
                "type": "string",
                "enum": [
                  "spring",
                  "summer",
                  "fall",
                  "winter"
                ]
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 28
              }
            },
            "required": [
              "season",
              "day"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "romanceable": {
        "default": null,
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "species": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "gender": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "occupation": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "affiliation": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "home_location_id": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "family": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "relation": {
              "type": "string"
            },
            "character_id": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "relation",
            "character_id"
          ],
          "additionalProperties": false
        }
      },
      "heart_events": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "hearts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "trigger": {
              "default": null,
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requires": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "skill",
                      "perk",
                      "quest",
                      "town_rank",
                      "building",
                      "tool",
                      "hearts",
                      "item",
                      "season_unlocked",
                      "location",
                      "year"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      ">=",
                      ">",
                      "==",
                      "has",
                      "done"
                    ]
                  },
                  "value": {
                    "default": null,
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "key",
                  "op",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "hearts",
            "trigger",
            "requires"
          ],
          "additionalProperties": false
        }
      },
      "is_vendor": {
        "default": false,
        "type": "boolean"
      },
      "shop_id": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "schedule_id": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "name",
      "numeric_id",
      "numeric_id_game_version",
      "id_status",
      "former_ids",
      "game_version",
      "version_added",
      "confidence",
      "prov",
      "data_gaps",
      "icon_key",
      "wiki_page",
      "blurb",
      "birthday",
      "romanceable",
      "species",
      "gender",
      "occupation",
      "affiliation",
      "home_location_id",
      "family",
      "heart_events",
      "is_vendor",
      "shop_id",
      "schedule_id"
    ],
    "additionalProperties": false
  }
}
