{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/fish.json",
  "title": "fish",
  "description": "Fish-only fields, keyed to an item. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "shadow_size": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "giant"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "catch_methods": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "fishing",
            "diving",
            "fish_trap",
            "fish_bait",
            "bug_net",
            "rock_break",
            "foraging",
            "dig_spot",
            "tree_shake",
            "mine_drop",
            "monster_drop",
            "crop_harvest",
            "ranching",
            "shop",
            "crafting",
            "cooking",
            "quest_reward",
            "festival",
            "mail",
            "chest"
          ]
        }
      },
      "is_legendary": {
        "default": false,
        "type": "boolean"
      },
      "school_size": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "rarity": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "item_id",
      "shadow_size",
      "catch_methods",
      "is_legendary",
      "school_size",
      "rarity"
    ],
    "additionalProperties": false
  }
}
