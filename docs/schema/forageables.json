{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/forageables.json",
  "title": "forageables",
  "description": "Forageable-only fields, keyed to an item. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "item_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "respawn_days": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "spawns_on": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "dirt_patch",
              "beach",
              "tree",
              "bush",
              "floor",
              "grass",
              "water"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "yields_seed_item_id": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "item_id",
      "respawn_days",
      "spawns_on",
      "yields_seed_item_id"
    ],
    "additionalProperties": false
  }
}
