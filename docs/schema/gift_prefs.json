{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/gift_prefs.json",
  "title": "gift_prefs",
  "description": "Gift preferences, one record per character. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "character_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "prefs": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "loved",
            "liked",
            "neutral",
            "disliked",
            "hated"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        },
        "required": [
          "loved",
          "liked",
          "neutral",
          "disliked",
          "hated"
        ]
      }
    },
    "required": [
      "character_id",
      "prefs"
    ],
    "additionalProperties": false
  }
}
