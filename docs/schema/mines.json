{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/mines.json",
  "title": "mines",
  "description": "Mine biomes and their floor ranges. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "numeric_id": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "numeric_id_game_version": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "id_status": {
        "default": "provisional",
        "type": "string",
        "enum": [
          "provisional",
          "confirmed_stale",
          "confirmed"
        ]
      },
      "former_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "game_version": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "version_added": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "type": "string",
        "enum": [
          "verified",
          "wiki",
          "inferred"
        ]
      },
      "prov": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "enum": [
            "game_files",
            "wiki_cargo",
            "wiki_page",
            "manual",
            "community_archive"
          ]
        }
      },
      "data_gaps": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "icon_key": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "wiki_page": {
        "default": null,
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "blurb": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "maxLength": 300
          },
          {
            "type": "null"
          }
        ]
      },
      "floors": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      },
      "ore_item_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "monster_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "fish_item_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "artifact_set_ids": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "hazards": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gate": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "skill",
                "perk",
                "quest",
                "town_rank",
                "building",
                "tool",
                "hearts",
                "item",
                "season_unlocked",
                "location",
                "year"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "enum": [
                ">=",
                ">",
                "==",
                "has",
                "done"
              ]
            },
            "value": {
              "default": null,
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "key",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "location_id": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "name",
      "numeric_id",
      "numeric_id_game_version",
      "id_status",
      "former_ids",
      "game_version",
      "version_added",
      "confidence",
      "prov",
      "data_gaps",
      "icon_key",
      "wiki_page",
      "blurb",
      "floors",
      "ore_item_ids",
      "monster_ids",
      "fish_item_ids",
      "artifact_set_ids",
      "hazards",
      "gate",
      "location_id"
    ],
    "additionalProperties": false
  }
}
