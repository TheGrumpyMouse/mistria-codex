{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistria-codex/schema/spots.json",
  "title": "spots",
  "description": "Fine-grained points: dig spots, dive holes, forage patches. Generated from packages/schema — do not edit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "location_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "x": {
        "type": "number"
      },
      "y": {
        "type": "number"
      },
      "kind": {
        "type": "string",
        "enum": [
          "dig_spot",
          "dive_hole",
          "forage_patch",
          "rock",
          "tree",
          "water",
          "entrance"
        ]
      },
      "seasons": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "fall",
            "winter"
          ]
        }
      },
      "map_version": {
        "default": 1,
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "id",
      "location_id",
      "x",
      "y",
      "kind",
      "seasons",
      "map_version"
    ],
    "additionalProperties": false
  }
}
